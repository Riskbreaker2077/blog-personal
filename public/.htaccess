# Configuración del servidor (Hostinger usa LiteSpeed, compatible con Apache).
# Este archivo se copia tal cual a dist/ y de ahí al hosting.
#
# HTTPS no se fuerza aquí a propósito: Hostinger lo resuelve en hPanel
# («Sitios web → Rendimiento/Seguridad → Forzar HTTPS»). Duplicar la
# redirección detrás de su proxy es la receta clásica del bucle infinito.

# Página de error propia. Sin esto el visitante ve la 404 genérica del hosting.
ErrorDocument 404 /404.html

# El listado automático de carpetas no es contenido del blog.
Options -Indexes

<IfModule mod_headers.c>
  # Los assets de /_astro/ llevan hash en el nombre: si cambia el contenido,
  # cambia la URL. Se pueden cachear para siempre sin miedo.
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # El HTML sí cambia bajo la misma URL: se revalida en cada visita.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # El feed y el sitemap cambian al publicar: una hora es suficiente.
  <FilesMatch "\.xml$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/xml application/rss+xml image/svg+xml
</IfModule>
