---
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource-variable/newsreader/wght.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Topbar from "../components/Topbar.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Camilo Moreno — bitácora",
  description = "Pensamiento largo en español sobre filosofía, educación, mundo editorial e inteligencia artificial.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta id="theme-color" name="theme-color" content="#f7f4ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // Resuelve el tema antes del primer pintado para evitar parpadeo.
      (() => {
        let tema = null;
        try {
          tema = localStorage.getItem("tema");
        } catch {
          tema = null;
        }
        if (tema !== "dark" && tema !== "light") {
          tema = window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }
        document.documentElement.dataset.theme = tema;
        const meta = document.getElementById("theme-color");
        if (meta) meta.content = tema === "dark" ? "#020609" : "#f7f4ee";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="shell">
      <Topbar />
      <main id="contenido" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
