---
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource-variable/newsreader/wght.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Topbar from "../components/Topbar.astro";
import { SITIO } from "../data/sitio";

interface Props {
  title?: string;
  description?: string;
  /** `article` en los posts; `website` en el resto. */
  tipo?: "website" | "article";
  /** Ruta o URL de la imagen social. Por defecto, la del sitio. */
  imagen?: string;
  publicado?: string;
  actualizado?: string;
  /** Datos estructurados schema.org. Se serializan en el `<head>`. */
  datosEstructurados?: Record<string, unknown>;
  /** Para páginas que no son destino, como la 404. */
  noindex?: boolean;
}

const {
  title = SITIO.nombre,
  description = SITIO.descripcion,
  tipo = "website",
  imagen = SITIO.imagenSocial,
  publicado,
  actualizado,
  datosEstructurados,
  noindex = false,
} = Astro.props;

/**
 * `Astro.site` viene de `site` en `astro.config.mjs`. Todo lo que se comparte
 * fuera del sitio —canonical, Open Graph, RSS— necesita URL absoluta: una ruta
 * relativa se rompe en cuanto sale del dominio.
 */
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenSocial = new URL(imagen, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta id="theme-color" name="theme-color" content="#f7f4ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <link rel="canonical" href={canonica} />
      )
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITIO.nombre}
      href={new URL("/rss.xml", Astro.site)}
    />
    <title>{title}</title>

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:locale" content={SITIO.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenSocial} />
    {
      tipo === "article" && (
        <>
          <meta property="article:author" content={SITIO.autor} />
          {publicado && (
            <meta property="article:published_time" content={publicado} />
          )}
          {actualizado && (
            <meta property="article:modified_time" content={actualizado} />
          )}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenSocial} />

    {
      datosEstructurados && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(datosEstructurados)}
        />
      )
    }
    <script is:inline>
      // Resuelve el tema antes del primer pintado para evitar parpadeo.
      (() => {
        let tema = null;
        try {
          tema = localStorage.getItem("tema");
        } catch {
          tema = null;
        }
        if (tema !== "dark" && tema !== "light") {
          tema = window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }
        document.documentElement.dataset.theme = tema;
        const meta = document.getElementById("theme-color");
        if (meta) meta.content = tema === "dark" ? "#020609" : "#f7f4ee";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="shell">
      <Topbar />
      <main id="contenido" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
