---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/", label: "índice", match: "/" },
  { href: "/sobre/", label: "sobre", match: "/sobre/" },
  { href: "/archivo/", label: "archivo", match: "/archivo/" },
];
---

{/*
  Ocupa en el flujo el hueco que la barra fija ya no deja, más el margen que
  la separa del contenido. Cuando sale de la pantalla es que el lector empezó
  a bajar. Se resuelve con IntersectionObserver y no escuchando `scroll`: no
  se ejecuta nada en cada cuadro del desplazamiento.
*/}
<span class="centinela" aria-hidden="true"></span>

<header class="topbar" data-topbar>
  {/*
    El `aria-label` del enlace manda sobre el texto interior, así que un lector
    de pantalla siempre oye «Camilo Moreno» aunque en móvil se vea «CM».
  */}
  <a class="brand" href="/" aria-label="Camilo Moreno, ir al índice">
    <span class="brand-dot" aria-hidden="true"></span>
    <span class="brand-largo">Camilo Moreno</span>
    <span class="brand-corto" aria-hidden="true">CM</span>
    <span class="brand-sub">— bitácora</span>
  </a>

  <nav class="nav" aria-label="Navegación principal">
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={currentPath === link.match ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-pressed="false"
          aria-label="Cambiar a modo oscuro"
        >
          <span aria-hidden="true">●</span>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Marca la barra en cuanto el testigo sale de la pantalla. Sin JavaScript la
  // marca se queda entera en escritorio y abreviada en móvil: ambas legibles.
  const barra = document.querySelector<HTMLElement>("[data-topbar]");
  const centinela = document.querySelector(".centinela");

  if (barra && centinela) {
    new IntersectionObserver(([entrada]) => {
      barra.toggleAttribute("data-scrolled", !entrada.isIntersecting);
    }).observe(centinela);

    // La altura real de la barra fija (y no un número inventado) es lo que
    // reserva su hueco en el flujo: así no se descuadra si cambia el
    // contenido, la fuente tarda en cargar o el usuario agranda el texto.
    const raiz = document.documentElement;
    const medir = () =>
      raiz.style.setProperty("--topbar-h", `${barra.offsetHeight}px`);
    medir();
    new ResizeObserver(medir).observe(barra);
  }

  const boton = document.getElementById("theme-toggle");
  const meta = document.getElementById("theme-color") as HTMLMetaElement | null;

  function pintar(tema: string) {
    document.documentElement.dataset.theme = tema;
    if (meta) meta.content = tema === "dark" ? "#020609" : "#f7f4ee";
    if (!boton) return;
    const oscuro = tema === "dark";
    boton.setAttribute("aria-pressed", String(oscuro));
    boton.setAttribute(
      "aria-label",
      oscuro ? "Cambiar a modo claro" : "Cambiar a modo oscuro",
    );
    const icono = boton.firstElementChild;
    if (icono) icono.textContent = oscuro ? "○" : "●";
  }

  pintar(document.documentElement.dataset.theme ?? "light");

  boton?.addEventListener("click", () => {
    const siguiente =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    try {
      localStorage.setItem("tema", siguiente);
    } catch {
      /* modo privado: el tema dura lo que la sesión */
    }
    pintar(siguiente);
  });
</script>

<style>
  /*
   * `fixed` y no `sticky`: con `sticky`, mientras el desplazamiento no supera
   * el padding superior del `.shell`, la barra viajaba pegada al contenido
   * antes de anclarse arriba, y ese primer tramo se veía como que «se
   * movía». Con `fixed` queda clavada en `--topbar-offset` desde el primer
   * píxel de scroll: el mismo aire que ya tenía arriba, pero constante.
   */
  .topbar {
    position: fixed;
    z-index: 20;
    top: var(--topbar-offset);
    right: 0;
    left: 0;
    width: min(100% - clamp(2.75rem, 9vw, 5rem), var(--shell-width));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-inline: auto;
    padding-block: 0.875rem;
  }

  /*
   * El velo que disuelve el texto al pasar por debajo. No puede ser un color
   * plano: el fondo del body lleva degradados fijos justo en la franja
   * superior, y taparlos con crema opaca deja un rectángulo visible. Por eso
   * es papel translúcido + desenfoque: lo que borra el texto es el desenfoque,
   * no la opacidad, y los degradados siguen asomando.
   *
   * Va `fixed` y anclado a la ventana, no `absolute` con márgenes
   * negativos en `vw`: eso lo dejaba 100vw más ancho que la
   * barra y ensanchaba la maquetación entera. En móvil el navegador respondía
   * encogiendo la página para que cupiera, con una franja muerta a la derecha.
   * Con `left: 0; right: 0` el velo mide exactamente la ventana y no puede
   * desbordarse por definición.
   *
   * `top: 0`, igual que `.topbar`: los dos tienen que arrancar en el mismo
   * punto o queda una franja sin desenfoque donde asoma crudo el degradado
   * del fondo del body.
   */
  .topbar::before {
    position: fixed;
    z-index: -1;
    top: 0;
    right: 0;
    left: 0;
    height: 7.5rem;
    backdrop-filter: blur(7px);
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--paper) 86%, transparent) 55%,
      color-mix(in oklab, var(--paper) 60%, transparent) 78%,
      transparent 100%
    );
    mask-image: linear-gradient(to bottom, #000 74%, transparent 100%);
    content: "";
    pointer-events: none;
  }

  /* Sin desenfoque, el texto asomaría legible: hace falta más papel. */
  @supports not (backdrop-filter: blur(1px)) {
    .topbar::before {
      background: linear-gradient(
        to bottom,
        color-mix(in oklab, var(--paper) 97%, transparent) 62%,
        transparent 100%
      );
    }
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand-dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--accent), var(--teal));
    animation: pulse 2.4s ease-out infinite;
  }

  .brand-sub {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .brand-corto {
    display: none;
  }

  .centinela {
    display: block;
    height: var(--topbar-h, 3.6rem);
    margin-bottom: clamp(2.75rem, 7vw, 4.5rem);
  }

  /*
   * Al bajar, la marca se contrae. Arriba del todo siempre se lee el nombre
   * completo, así que quien llega sabe de quién es el sitio y ve de dónde sale
   * el «CM».
   */
  .topbar[data-scrolled] .brand-largo,
  .topbar[data-scrolled] .brand-sub {
    display: none;
  }

  .topbar[data-scrolled] .brand-corto {
    display: inline;
  }

  ul {
    display: flex;
    align-items: center;
    gap: 1.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    position: relative;
    display: inline-block;
    padding-block: 4px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav a:hover,
  .nav a[aria-current="page"] {
    color: var(--ink);
  }

  .nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: -2px;
    left: 0;
    height: 2px;
    border-radius: 1px;
    background: var(--accent);
    content: "";
  }

  .theme-toggle {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: none;
    color: var(--muted);
    font-size: 0.75rem;
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .theme-toggle:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  /*
   * En móvil se abrevia desde el principio, sin esperar al scroll: el nombre
   * completo más la navegación no caben en una fila de 360 px y la barra se
   * partiría en dos renglones. El enlace sigue anunciándose entero por voz.
   */
  @media (max-width: 34rem) {
    .topbar {
      gap: 1rem;
    }

    .centinela {
      margin-bottom: 2.5rem;
    }

    .brand-largo,
    .brand-sub {
      display: none;
    }

    .brand-corto {
      display: inline;
      letter-spacing: 0.02em;
    }

    ul {
      gap: 1rem;
    }
  }
</style>
