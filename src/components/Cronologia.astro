---
import { TEMAS } from "../data/temas";
import {
  contarEntradas,
  formatearFecha,
  tiempoDeLectura,
  type GrupoAnual,
} from "../lib/posts";

interface Props {
  grupos: GrupoAnual[];
}

const { grupos } = Astro.props;
---

<div class="timeline">
  {
    grupos.map((grupo) => (
      <>
        <div class="year">
          <p class="year-num">{grupo.anio}</p>
          <p class="year-caption">{contarEntradas(grupo.posts.length)}</p>
        </div>

        {grupo.posts.map((post) => (
          <article class="row" data-tone={TEMAS[post.data.topic].tono}>
            <p class="row-date">
              <time datetime={post.data.pubDate}>
                {formatearFecha(post.data.pubDate, "corto")}
              </time>
            </p>
            <span class="row-marker" aria-hidden="true" />
            <div class="row-body">
              <h3 class="row-title">
                <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p class="row-excerpt">{post.data.description}</p>
              <p class="row-meta">
                <span class="cat" data-tone={TEMAS[post.data.topic].tono}>
                  {TEMAS[post.data.topic].label}
                </span>
                <span>{tiempoDeLectura(post.body ?? "")} min</span>
                {post.data.draft && <span class="draft">borrador</span>}
              </p>
            </div>
          </article>
        ))}
      </>
    ))
  }
</div>

<style>
  .timeline {
    position: relative;
  }

  .timeline::before {
    position: absolute;
    top: 6px;
    bottom: 0;
    left: calc(var(--rail) + var(--rail-gap) / 2);
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent 0,
      color-mix(in oklab, var(--accent) 60%, transparent) 18px,
      color-mix(in oklab, var(--coffee) 45%, transparent) 55%,
      color-mix(in oklab, var(--gold) 45%, transparent) calc(100% - 80px),
      transparent 100%
    );
    content: "";
  }

  .year {
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: var(--rail-gap);
    align-items: baseline;
    margin: 0 0 1.375rem;
  }

  .year:not(:first-child) {
    margin-top: 2.75rem;
  }

  .year-num {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums;
  }

  .year-caption {
    margin: 0;
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
    color: var(--muted-2);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: var(--rail-gap);
    padding-block: 1.15rem;
    border-bottom: 1px dashed var(--rule);
  }

  .row:last-of-type {
    border-bottom: 0;
  }

  .row-date {
    margin: 0;
    padding-top: 6px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .row-marker {
    position: absolute;
    top: 50%;
    left: calc(var(--rail) + var(--rail-gap) / 2 - 5px);
    z-index: 1;
    width: 11px;
    height: 11px;
    border: 2px solid var(--muted-2);
    border-radius: 50%;
    background: var(--cream);
    transform: translateY(-50%);
  }

  .row[data-tone="accent"] .row-marker {
    border-color: var(--tone-accent);
  }

  .row[data-tone="gold"] .row-marker {
    border-color: var(--tone-gold);
  }

  .row[data-tone="ink"] .row-marker {
    border-color: var(--tone-ink);
  }

  .row[data-tone="peri"] .row-marker {
    border-color: var(--tone-peri);
  }

  .row-body {
    padding-left: 1.5rem;
  }

  .row-title {
    margin: 0 0 0.375rem;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.42rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .row-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  /*
   * La fila entera es zona de clic sin JavaScript: el enlace del título se
   * estira sobre el artículo. El resto de la fila es texto plano, así que
   * ningún otro enlace queda debajo.
   */
  .row-title a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .row:hover .row-title a,
  .row-title a:focus-visible {
    color: var(--accent);
  }

  .row-excerpt {
    max-width: 36rem;
    margin: 0 0 0.625rem;
    color: var(--ink-2);
    font-size: 0.98rem;
    line-height: 1.5;
    opacity: 0.78;
  }

  .row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cat[data-tone="accent"] {
    color: var(--accent);
  }

  .cat[data-tone="gold"] {
    color: var(--gold);
  }

  .cat[data-tone="ink"] {
    color: var(--teal);
  }

  .cat[data-tone="peri"] {
    color: var(--coffee);
  }

  .draft {
    color: var(--rose);
  }
</style>
