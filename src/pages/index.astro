---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ENTRADAS_ANUNCIADAS, TEMAS } from "../data/temas";

const entradas = ENTRADAS_ANUNCIADAS;
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-wrap">
      <div class="hero-copy">
        <h1 id="hero-title">
          Notas sobre filosofía, educación y <span class="em"
            >máquinas que parecen pensar</span
          >.
        </h1>
        <p>
          Soy Camilo. Doy clases, leo despacio y escribo aquí cuando una idea me
          persigue durante más de una semana. Sin calendario editorial, sin
          newsletter, sin prisa.
        </p>
        <p class="hero-meta">
          <span>bitácora</span>
          <span>desde el Quindío</span>
          <span>desde 2021</span>
        </p>
      </div>

      <figure class="hero-figure">
        <div class="img-frame" style="aspect-ratio: 3 / 4">
          <div>Retrato o ilustración — 3:4</div>
        </div>
        <figcaption class="img-caption">retrato / ilustración</figcaption>
      </figure>
    </div>
  </section>

  <section class="timeline" aria-labelledby="timeline-title">
    <h2 id="timeline-title" class="visually-hidden">Línea del pensamiento</h2>

    <div class="year">
      <p class="year-num">2026</p>
      <p class="year-caption">
        {entradas.length}
        {entradas.length === 1 ? "entrada en camino" : "entradas en camino"}
      </p>
    </div>

    {
      entradas.map((entrada) => (
        <article class="row" data-tone={TEMAS[entrada.tema].tono}>
          <p class="row-date">{entrada.estado}</p>
          <span class="row-marker" aria-hidden="true" />
          <div class="row-body">
            <h3 class="row-title">{entrada.title}</h3>
            <p class="row-excerpt">{entrada.description}</p>
            <p class="row-meta">
              <span class="cat" data-tone={TEMAS[entrada.tema].tono}>
                {TEMAS[entrada.tema].label}
              </span>
              <span>sin publicar</span>
            </p>
          </div>
        </article>
      ))
    }
  </section>

  <p class="closing">
    Mientras tanto, puedes leer <a href="/sobre/">de qué va este cuaderno</a> o mirar
    el <a href="/archivo/">archivo</a>.
  </p>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── Hero ───────────────────────────────────────── */
  .hero {
    margin-bottom: 3rem;
  }

  .hero-wrap {
    display: grid;
    grid-template-columns: 1fr 14rem;
    gap: 2.75rem;
    align-items: end;
  }

  h1 {
    position: relative;
    z-index: 0;
    margin: 0 0 1.75rem;
    font-size: clamp(2.4rem, 5.5vw, 3.6rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .em {
    position: relative;
    color: var(--accent);
    font-style: italic;
  }

  .em::after {
    position: absolute;
    z-index: -1;
    right: -2px;
    bottom: 6px;
    left: -2px;
    height: 8px;
    border-radius: 2px;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--accent) 50%, transparent),
      color-mix(in oklab, var(--teal) 45%, transparent) 55%,
      color-mix(in oklab, var(--gold) 55%, transparent)
    );
    content: "";
    transform: skew(-6deg, -1deg);
  }

  .hero-copy > p:not(.hero-meta) {
    max-width: 35rem;
    margin: 0;
    color: var(--ink-2);
    font-size: 1.18rem;
    line-height: 1.55;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.125rem;
    margin: 1.75rem 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-meta span::before {
    color: var(--muted-2);
    content: "— ";
  }

  .hero-meta span:first-child::before {
    content: "";
  }

  .hero-figure {
    margin: 0;
  }

  /* ── Línea del pensamiento ──────────────────────── */
  .timeline {
    position: relative;
  }

  .timeline::before {
    position: absolute;
    top: 6px;
    bottom: 0;
    left: calc(var(--rail) + var(--rail-gap) / 2);
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent 0,
      color-mix(in oklab, var(--accent) 60%, transparent) 18px,
      color-mix(in oklab, var(--coffee) 45%, transparent) 55%,
      color-mix(in oklab, var(--gold) 45%, transparent) calc(100% - 80px),
      transparent 100%
    );
    content: "";
  }

  .year {
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: var(--rail-gap);
    align-items: baseline;
    margin: 0 0 1.375rem;
  }

  .year-num {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums;
  }

  .year-caption {
    margin: 0;
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
    color: var(--muted-2);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: var(--rail-gap);
    padding-block: 1.15rem;
    border-bottom: 1px dashed var(--rule);
  }

  .row:last-of-type {
    border-bottom: 0;
  }

  .row-date {
    margin: 0;
    padding-top: 6px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .row-marker {
    position: absolute;
    top: 50%;
    left: calc(var(--rail) + var(--rail-gap) / 2 - 5px);
    z-index: 1;
    width: 11px;
    height: 11px;
    border: 2px solid var(--muted-2);
    border-radius: 50%;
    background: var(--cream);
    transform: translateY(-50%);
  }

  .row[data-tone="accent"] .row-marker {
    border-color: var(--tone-accent);
  }

  .row[data-tone="gold"] .row-marker {
    border-color: var(--tone-gold);
  }

  .row[data-tone="ink"] .row-marker {
    border-color: var(--tone-ink);
  }

  .row[data-tone="peri"] .row-marker {
    border-color: var(--tone-peri);
  }

  .row-body {
    padding-left: 1.5rem;
  }

  .row-title {
    margin: 0 0 0.375rem;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.42rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .row-excerpt {
    max-width: 36rem;
    margin: 0 0 0.625rem;
    color: var(--ink-2);
    font-size: 0.98rem;
    line-height: 1.5;
    opacity: 0.78;
  }

  .row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cat[data-tone="accent"] {
    color: var(--accent);
  }

  .cat[data-tone="gold"] {
    color: var(--gold);
  }

  .cat[data-tone="ink"] {
    color: var(--teal);
  }

  .cat[data-tone="peri"] {
    color: var(--coffee);
  }

  .closing {
    margin: var(--space-6) 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .closing a {
    color: var(--ink);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .closing a:hover {
    color: var(--accent);
  }

  @media (max-width: 47.5rem) {
    .hero-wrap {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .hero-figure {
      max-width: 14rem;
    }
  }
</style>
