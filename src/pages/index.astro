---
import BaseLayout from "../layouts/BaseLayout.astro";
import Cronologia from "../components/Cronologia.astro";
import FiltroTemas from "../components/FiltroTemas.astro";
import GrafoCerebral from "../components/GrafoCerebral.astro";
import { agruparPorAnio, contarEntradas, obtenerPosts } from "../lib/posts";

const MAXIMO_RECIENTES = 5;

const posts = await obtenerPosts();
const recientes = posts.slice(0, MAXIMO_RECIENTES);
const grupos = agruparPorAnio(recientes);
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-wrap">
      <div class="hero-copy">
        <h1 id="hero-title">
          Apuntes sobre filosofía, educación y <span class="em">tecnología</span
          >.
        </h1>
        <p>
          Un espacio para reflexionar sobre las situaciones presentes, los
          pensamientos pasados y las ideas de futuro. No busca ser muy
          académico, ni tampoco difundir; es un lugar de personal reflexión. Por
          eso, es público.
        </p>
      </div>

      <div class="hero-grafo">
        <GrafoCerebral />
      </div>
    </div>
  </section>

  <div class="filtros">
    <FiltroTemas activo="todos" />
  </div>

  <section aria-labelledby="timeline-title">
    <h2 id="timeline-title" class="visually-hidden">Línea del pensamiento</h2>

    {
      posts.length > 0 ? (
        <Cronologia grupos={grupos} />
      ) : (
        <p class="vacio">
          Todavía no hay textos publicados. El primero aparecerá aquí, y de ahí
          pasará al <a href="/archivo/">archivo</a> sin que nadie tenga que
          moverlo.
        </p>
      )
    }
  </section>

  {
    /*
     * Solo cuando hay más textos de los que caben en la portada: si están
     * todos a la vista, el cierre no dice nada que no se vea ya.
     */
    posts.length > recientes.length && (
      <p class="closing">
        Estos son los {MAXIMO_RECIENTES} más recientes de{" "}
        {contarEntradas(posts.length)}. El resto está en el{" "}
        <a href="/archivo/">archivo</a>.
      </p>
    )
  }
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── Hero ───────────────────────────────────────── */
  .hero {
    margin-bottom: 3rem;
  }

  .hero-wrap {
    display: grid;
    /*
     * 20rem, no 14rem: el grafo necesita ancho para leerse como figura y no
     * como ruido. Al texto le quedan ~35rem, justo su medida de lectura.
     */
    grid-template-columns: 1fr 20rem;
    gap: 2.75rem;
    align-items: end;
  }

  h1 {
    position: relative;
    z-index: 0;
    margin: 0 0 1.75rem;
    font-size: clamp(2.4rem, 5.5vw, 3.6rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .em {
    position: relative;
    color: var(--accent);
    font-style: italic;
  }

  .em::after {
    position: absolute;
    z-index: -1;
    right: -2px;
    bottom: 6px;
    left: -2px;
    height: 8px;
    border-radius: 2px;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--accent) 50%, transparent),
      color-mix(in oklab, var(--teal) 45%, transparent) 55%,
      color-mix(in oklab, var(--gold) 55%, transparent)
    );
    content: "";
    transform: skew(-6deg, -1deg);
  }

  /* Por encima del grafo: el texto se lee y se selecciona, el grafo pasa detrás. */
  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-copy > p {
    max-width: 35rem;
    margin: 0;
    color: var(--ink-2);
    font-size: 1.12rem;
    line-height: 1.6;
  }

  /*
   * Sin marco, sin fondo y sin pie: el grafo no es una ilustración metida en
   * una caja, es parte del papel. Se desborda de su columna hacia el texto y
   * la máscara radial disuelve los cuatro bordes, de modo que el lienzo no
   * termina en ninguna parte: los nodos simplemente se apagan.
   *
   * `closest-side` no es opcional. Por defecto la elipse se mide hasta la
   * esquina más lejana, así que en mitad del borde inferior la máscara aún era
   * opaca y el lienzo se cortaba en seco justo encima de los filtros.
   *
   * El margen derecho se queda en -1rem a propósito: el canalón mínimo de
   * `.shell` es 1.375rem, y pasarse de ahí saca una barra de scroll horizontal.
   */
  .hero-grafo {
    position: relative;
    z-index: 0;
    align-self: center;
    aspect-ratio: 4 / 3;
    margin: -3rem -1rem -3rem -9rem;
    -webkit-mask-image: radial-gradient(
      ellipse closest-side at center,
      #000 45%,
      rgb(0 0 0 / 0.6) 72%,
      transparent 96%
    );
    mask-image: radial-gradient(
      ellipse closest-side at center,
      #000 45%,
      rgb(0 0 0 / 0.6) 72%,
      transparent 96%
    );
  }

  /* El grafo se desborda hacia abajo; los filtros tienen que seguir siendo clicables. */
  .filtros {
    position: relative;
    z-index: 1;
  }

  .vacio {
    max-width: var(--max-content);
    margin: 0;
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: 1.02rem;
  }

  .vacio a {
    color: var(--accent);
    text-underline-offset: 0.25em;
  }

  .closing {
    margin: var(--space-6) 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .closing a {
    color: var(--ink);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .closing a:hover {
    color: var(--accent);
  }

  @media (max-width: 47.5rem) {
    .hero-wrap {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    /*
     * En una sola columna el grafo no tiene sobre qué desbordarse: queda como
     * un bloque suelto entre el texto y los filtros. Mejor no mostrarlo.
     * Los observadores del componente lo detectan y detienen el bucle solo.
     */
    .hero-grafo {
      display: none;
    }
  }
</style>
