---
import BaseLayout from "../layouts/BaseLayout.astro";
import Cronologia from "../components/Cronologia.astro";
import FiltroTemas from "../components/FiltroTemas.astro";
import { agruparPorAnio, contarEntradas, obtenerPosts } from "../lib/posts";

const MAXIMO_RECIENTES = 5;

const posts = await obtenerPosts();
const recientes = posts.slice(0, MAXIMO_RECIENTES);
const grupos = agruparPorAnio(recientes);
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-wrap">
      <div class="hero-copy">
        <h1 id="hero-title">
          Notas sobre filosofía, educación y <span class="em"
            >máquinas que parecen pensar</span
          >.
        </h1>
        <p>
          Soy Camilo. Doy clases, leo despacio y escribo aquí cuando una idea me
          persigue durante más de una semana. Sin calendario editorial, sin
          newsletter, sin prisa.
        </p>
        <p class="hero-meta">
          <span>bitácora</span>
          <span>desde el Quindío</span>
          <span>desde 2021</span>
        </p>
      </div>

      <figure class="hero-figure">
        <div class="img-frame" style="aspect-ratio: 3 / 4">
          <div>Retrato o ilustración — 3:4</div>
        </div>
        <figcaption class="img-caption">retrato / ilustración</figcaption>
      </figure>
    </div>
  </section>

  <FiltroTemas activo="todos" />

  <section aria-labelledby="timeline-title">
    <h2 id="timeline-title" class="visually-hidden">Línea del pensamiento</h2>

    {
      posts.length > 0 ? (
        <Cronologia grupos={grupos} />
      ) : (
        <p class="vacio">
          Todavía no hay textos publicados. El primero aparecerá aquí, y de ahí
          pasará al <a href="/archivo/">archivo</a> sin que nadie tenga que
          moverlo.
        </p>
      )
    }
  </section>

  <p class="closing">
    {
      posts.length > recientes.length ? (
        <>
          Estos son los {MAXIMO_RECIENTES} más recientes de{" "}
          {contarEntradas(posts.length)}. El resto está en el{" "}
          <a href="/archivo/">archivo</a>.
        </>
      ) : (
        <>
          También puedes leer <a href="/sobre/">de qué va este cuaderno</a> o
          mirar el <a href="/archivo/">archivo</a>.
        </>
      )
    }
  </p>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── Hero ───────────────────────────────────────── */
  .hero {
    margin-bottom: 3rem;
  }

  .hero-wrap {
    display: grid;
    grid-template-columns: 1fr 14rem;
    gap: 2.75rem;
    align-items: end;
  }

  h1 {
    position: relative;
    z-index: 0;
    margin: 0 0 1.75rem;
    font-size: clamp(2.4rem, 5.5vw, 3.6rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .em {
    position: relative;
    color: var(--accent);
    font-style: italic;
  }

  .em::after {
    position: absolute;
    z-index: -1;
    right: -2px;
    bottom: 6px;
    left: -2px;
    height: 8px;
    border-radius: 2px;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--accent) 50%, transparent),
      color-mix(in oklab, var(--teal) 45%, transparent) 55%,
      color-mix(in oklab, var(--gold) 55%, transparent)
    );
    content: "";
    transform: skew(-6deg, -1deg);
  }

  .hero-copy > p:not(.hero-meta) {
    max-width: 35rem;
    margin: 0;
    color: var(--ink-2);
    font-size: 1.18rem;
    line-height: 1.55;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.125rem;
    margin: 1.75rem 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-meta span::before {
    color: var(--muted-2);
    content: "— ";
  }

  .hero-meta span:first-child::before {
    content: "";
  }

  .hero-figure {
    margin: 0;
  }

  .vacio {
    max-width: var(--max-content);
    margin: 0;
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: 1.02rem;
  }

  .vacio a {
    color: var(--accent);
    text-underline-offset: 0.25em;
  }

  .closing {
    margin: var(--space-6) 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .closing a {
    color: var(--ink);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .closing a:hover {
    color: var(--accent);
  }

  @media (max-width: 47.5rem) {
    .hero-wrap {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .hero-figure {
      max-width: 14rem;
    }
  }
</style>
