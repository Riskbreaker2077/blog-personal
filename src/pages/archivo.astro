---
import BaseLayout from "../layouts/BaseLayout.astro";
import FiltroTemas from "../components/FiltroTemas.astro";
import { TEMAS } from "../data/temas";
import {
  agruparPorAnio,
  contarEntradas,
  formatearFecha,
  obtenerPosts,
} from "../lib/posts";

const posts = await obtenerPosts();
const grupos = agruparPorAnio(posts);
---

<BaseLayout
  title="Archivo — Camilo Moreno"
  description="Archivo cronológico de la bitácora de Camilo Moreno."
>
  <header class="archive-head">
    <h1>Archivo <em>cronológico</em>.</h1>
    <p>
      Todas las entradas, de la más reciente a la más antigua.
      {posts.length > 0 && <span class="total">{contarEntradas(posts.length)} en total.</span>}
    </p>
  </header>

  <FiltroTemas activo="todos" hrefTodos="/archivo/" />

  {
    grupos.map((grupo) => (
      <section class="archive-section" aria-labelledby={`anio-${grupo.anio}`}>
        <h2 class="yr" id={`anio-${grupo.anio}`}>
          {grupo.anio}
        </h2>
        <ul>
          {grupo.posts.map((post) => (
            <li>
              <span class="a-date">
                <time datetime={post.data.pubDate}>
                  {formatearFecha(post.data.pubDate, "corto")}
                </time>
              </span>
              <a class="a-title" href={`/posts/${post.id}/`}>
                {post.data.title}
              </a>
              <span class="a-tag">
                {TEMAS[post.data.topic].label.toLowerCase()}
                {post.data.draft && <span class="draft"> · borrador</span>}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    posts.length === 0 && (
      <section class="empty" aria-labelledby="empty-title">
        <p class="yr">—</p>
        <div>
          <h2 id="empty-title">Todavía no hay entradas publicadas.</h2>
          <p>
            El archivo se llena solo: cada texto publicado aparece aquí agrupado
            por año. Mientras tanto puedes leer{" "}
            <a href="/sobre/">de qué va este cuaderno</a>.
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .archive-head {
    max-width: 45rem;
    margin-bottom: 2.25rem;
  }

  .archive-head h1 {
    margin: 0 0 0.875rem;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .archive-head h1 em {
    color: var(--accent);
  }

  .archive-head p {
    margin: 0;
    color: var(--ink-2);
  }

  .total {
    color: var(--muted);
  }

  .archive-section {
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: var(--rail-gap);
    margin-bottom: 3rem;
  }

  .yr {
    margin: 0;
    padding-top: 4px;
    color: var(--muted);
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.625rem 0;
    border-bottom: 1px dashed var(--rule);
    transition: padding-left 0.2s;
  }

  li:hover {
    padding-left: 8px;
  }

  .a-date {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .a-title {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.3;
    text-decoration: none;
    transition: color 0.2s;
  }

  .a-title:hover,
  .a-title:focus-visible {
    color: var(--accent);
  }

  .a-tag {
    color: var(--muted-2);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .draft {
    color: var(--rose);
  }

  .empty {
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: var(--rail-gap);
    padding-bottom: 3rem;
    border-bottom: 1px dashed var(--rule);
  }

  .empty h2 {
    margin: 0 0 0.625rem;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .empty p {
    max-width: var(--max-content);
    margin: 0;
    color: var(--ink-2);
    font-size: 0.98rem;
    opacity: 0.85;
  }

  .empty a {
    color: var(--accent);
    text-underline-offset: 0.25em;
  }

  @media (max-width: 43.75rem) {
    .archive-section,
    .empty {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    li {
      grid-template-columns: 4rem 1fr;
      row-gap: 0.25rem;
    }

    .a-tag {
      grid-column: 2;
    }
  }
</style>
